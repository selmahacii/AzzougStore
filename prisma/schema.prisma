enum expensecategory {
  ADVERTISING
  SHIPPING
  RENT
  SALARY
  COMMISSION
  PACKAGING
  SOFTWARE
  MAINTENANCE
  TAXES
  SUPPLIER
  FUEL
  OTHER
}

enum expensestatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum paymentstatus {
  PENDING
  PARTIAL
  PAID
}

enum receptionstatus {
  PENDING
  PARTIAL
  RECEIVED
  CANCELLED
}

enum refundstatus {
  PENDING
  PARTIAL
  REFUNDED
  CREDIT_NOTE
  REJECTED
}

enum returnreason {
  DEFECTIVE
  WRONG_ITEM
  DAMAGED
  QUALITY_ISSUE
  OVERSTOCK
  OTHER
}

enum returnstatus {
  PENDING
  IN_TRANSIT
  RECEIVED_BY_SUPPLIER
  CLOSED
  CANCELLED
}

enum transactiontype {
  DISBURSEMENT
  CHARGE
  PAYMENT
  TRANSFER
}

enum wallettype {
  BANK
  CASH
  MOBILE
  COD
}
