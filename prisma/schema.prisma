  totalCredit Int      @map("total_credit")
  createdAt   DateTime @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  returnEntry Return   @relation(fields: [returnId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([id], map: "ix_return_items_id")
  @@index([productId], map: "ix_return_items_product_id")
  @@index([returnId], map: "ix_return_items_return_id")
  @@map("return_items")
}

model Expense {
  id               String          @id @default(cuid()) @db.VarChar
  storeId          String          @map("store_id") @db.VarChar
  category         expensecategory
  label            String          @db.VarChar
  description      String?
  amount           Int
  taxAmount        Int?            @map("tax_amount")
  totalAmount      Int             @map("total_amount")
  status           expensestatus?
  expenseDate      DateTime        @map("expense_date") @db.Date
  isRecurring      Boolean?        @map("is_recurring")
  recurrencePeriod String?         @map("recurrence_period") @db.VarChar
  walletId         String?         @map("wallet_id") @db.VarChar
  receiptUrl       String?         @map("receipt_url") @db.VarChar
  beneficiary      String?         @db.VarChar
  createdBy        String?         @map("created_by") @db.VarChar
  createdAt        DateTime        @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamp(6)
  creator          User?           @relation("ExpenseCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  store            Store           @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wallets          Wallet?         @relation(fields: [walletId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([category], map: "ix_expenses_category")
  @@index([id], map: "ix_expenses_id")
  @@index([storeId], map: "ix_expenses_store_id")
  @@map("expenses")
}

model Wallet {
  id           String                 @id @default(cuid()) @db.VarChar
  storeId      String                 @map("store_id") @db.VarChar
  name         String                 @db.VarChar
  type         wallettype?
  balance      Int?
  totalIn      Int?                   @map("total_in")
  totalOut     Int?                   @map("total_out")
  description  String?                @db.VarChar
  isActive     Boolean?               @map("is_active")
  createdAt    DateTime?              @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?              @updatedAt @map("updated_at") @db.Timestamp(6)
  expenses     Expense[]
  transactions FinancialTransaction[]
  store        Store                  @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_wallets_id")
  @@map("wallets")
}

model FinancialTransaction {
  id              String          @id @default(cuid()) @db.VarChar
