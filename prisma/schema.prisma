}

model PurchaseItem {
  id               String   @id @default(cuid()) @db.VarChar
  purchaseId       String   @map("purchase_id") @db.VarChar
  productId        String   @map("product_id") @db.VarChar
  productName      String   @map("product_name") @db.VarChar
  sku              String?  @db.VarChar
  quantity         Int
  unitCost         Int      @map("unit_cost")
  totalCost        Int      @map("total_cost")
  receivedQuantity Int?     @map("received_quantity")
  createdAt        DateTime @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  product          Product  @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  purchase         Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([id], map: "ix_purchase_items_id")
  @@index([productId], map: "ix_purchase_items_product_id")
  @@index([purchaseId], map: "ix_purchase_items_purchase_id")
  @@map("purchase_items")
}

model Return {
  id             String        @id @default(cuid()) @db.VarChar
  storeId        String        @map("store_id") @db.VarChar
  supplierId     String        @map("supplier_id") @db.VarChar
  warehouseId    String        @map("warehouse_id") @db.VarChar
  purchaseId     String?       @map("purchase_id") @db.VarChar
  reference      String        @unique(map: "ix_returns_reference") @db.VarChar
  totalCredit    Int?          @map("total_credit")
  amountRefunded Int?          @map("amount_refunded")
  reason         returnreason?
  refundStatus   refundstatus? @map("refund_status")
  status         returnstatus?
  note           String?
  shippedAt      DateTime?     @map("shipped_at") @db.Timestamp(6)
  closedAt       DateTime?     @map("closed_at") @db.Timestamp(6)
  createdBy      String?       @map("created_by") @db.VarChar
  createdAt      DateTime      @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)
  items          ReturnItem[]
  creator        User?         @relation("ReturnCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourcePurchase Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  store          Store         @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier       Supplier      @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse      Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_returns_id")
  @@index([purchaseId], map: "ix_returns_purchase_id")
  @@index([storeId], map: "ix_returns_store_id")
  @@index([supplierId], map: "ix_returns_supplier_id")
  @@index([warehouseId], map: "ix_returns_warehouse_id")
  @@map("returns")
}

model ReturnItem {
  id          String   @id @default(cuid()) @db.VarChar
  returnId    String   @map("return_id") @db.VarChar
  productId   String   @map("product_id") @db.VarChar
  productName String   @map("product_name") @db.VarChar
  sku         String?  @db.VarChar
  quantity    Int
